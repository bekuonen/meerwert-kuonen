# Kanonische Domain; Pfad und Query-Parameter bleiben erhalten.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.meerwert\.ch$ [NC]
  RewriteRule ^ https://meerwert.ch%{REQUEST_URI} [R=301,L,NE]
  # Ehemalige Formularbestaetigung nicht mehr ausliefern.
  RewriteRule ^danke/?$ /kontakt/ [R=301,L]
  # Auch beim Ueberschreiben eines alten Builds keine Taxonomie-Reste ausliefern.
  RewriteRule ^(?:categories|tags)(?:/.*)?$ - [R=404,L]
</IfModule>
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>
